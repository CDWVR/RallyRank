# Local development. Copy to .env; these values match docker-compose.yml.
#   docker compose up -d && npm run migrate:dev
#   npm run dev:server   (API on PORT)   +   npm run dev   (Vite on :3000, proxies /api and /rest)

# --- Server (never exposed to the browser) ---
DATABASE_URL=postgres://postgres:postgres@localhost:54322/rallyrank
# PostgREST logs in as the `authenticator` role with this password; migrate sets it.
AUTHENTICATOR_PASSWORD=authenticator-dev-password
# Shared with PostgREST (PGRST_JWT_SECRET). 32+ characters; use a long random value in production.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
POSTGREST_URL=http://localhost:3001
PORT=8787

# --- Browser build (optional) ---
# Keep all data in the browser instead of the server (offline demo, GitHub Pages).
# VITE_BACKEND=local
# Only for hosting under a subpath, e.g. /RallyRank/ on GitHub Pages.
# VITE_BASE_URL=/
