# Cloud Supabase (optional for local feature access)
# Leave these unset / keep placeholders to use the built-in local IndexedDB/localStorage backend.
# Paste real values from Supabase → Settings → API Keys to use the cloud project instead.

# Project URL — Settings → API (or Project Settings → Data API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable key (sb_publishable_...) — Settings → API Keys
# Replaces the legacy anon JWT. Safe to use in the browser; RLS still applies.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional: only needed for GitHub Pages / non-root hosting
VITE_BASE_URL=/
